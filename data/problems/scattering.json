    {
      "id": "weak-multiplicity",
      "title": "Randomized, SSYNC, weak multiplicity detection",
      "assumptions": {
        "visibility": "unlimited",
        "opacity": "transparent",
        "faults": "none",
        "scheduler": "ssync",
        "algorithm": "randomized",
        "multiplicity": "weak",
        "body": "point"
      },
      "summary": "Without strong multiplicity detection no algorithm scatters in $O(1)$ expected rounds; with an optimal number of random bits $O(\\log\\log n)$ rounds suffice.",
      "lower_bounds": [
        {
          "measure": "time",
          "bound": "\\text{not } O(1)",
          "ref": "Bramas2017RandomBit",
          "bottleneck": "symmetry breaking",
          "preconditions": [
            "Theorem 4.1: no algorithm runs in $O(1)$ expected rounds without strong multiplicity detection"
          ]
        },
        {
          "measure": "time",
          "bound": "\\Omega(\\log\\log n)",
          "ref": "Bramas2017RandomBit",
          "bottleneck": "symmetry breaking",
          "preconditions": [
            "Theorem 4.5: only for algorithms that use the optimal number of random bits"
          ]
        }
      ],
      "results": [
        {
          "ref": "Bramas2017RandomBit",
          "role": "best",
          "time": "O(\\log\\log n)",
          "colours": "0",
          "note": "Corollary 4.1, with an optimal number of random bits. The analysis is in FSYNC; the algorithms are valid in SSYNC. Without any multiplicity detection, algorithm $SA_\\phi$ (their $SA_f$) scatters in $O(\\phi(n))$ expected rounds for any increasing surjective function $\\phi$ (Theorem 4.2), but the robots never stop moving."
        }
      ],
      "optimality": {
        "time": {
          "status": "tight",
          "note": "$\\Theta(\\log\\log n)$ among bit-optimal algorithms; in general only \"not $O(1)$\" is known."
        },
        "colours": {
          "status": "tight",
          "note": "No colours."
        }
      },
      "open": [],
      "notes": "$n\\log n$ random bits are necessary in any setting [Bramas2017RandomBit]. Bramas and Tixeuil split multiplicity detection into local and global. Checked against arXiv 1309.6603 version 2, not the journal version.",
