        }
      },
      "open": [
        "Is point convergence with limited visibility solvable in full ASYNC, without perception or motion errors? [Kirkpatrick2024Separating]",
        "Is there a problem that separates k-ASYNC from SSYNC? [Kirkpatrick2024Separating]"
      ],
      "notes": "",
      "status": "verified"
    }
